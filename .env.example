# StormTrace local service credentials.
#
# Copy to .env and change every value before exposing any port beyond
# localhost. The defaults below are the same weak development values the
# compose file falls back to, so a fresh clone works with no setup.
#
#   cp .env.example .env
#
# .env is git-ignored.

# MinIO / S3 lakehouse
STORMTRACE_S3_ENDPOINT=http://127.0.0.1:9000
STORMTRACE_S3_BUCKET=stormtrace
STORMTRACE_S3_ACCESS_KEY=minioadmin
STORMTRACE_S3_SECRET_KEY=minioadmin

# Redpanda / Kafka event stream
STORMTRACE_KAFKA_BOOTSTRAP=127.0.0.1:9092
STORMTRACE_KAFKA_TOPIC=stormtrace.pipeline.events

# Grafana
STORMTRACE_GRAFANA_PASSWORD=admin
# Anonymous read-only viewing. Set to false when Grafana is not on
# localhost only.
STORMTRACE_GRAFANA_ANONYMOUS=true

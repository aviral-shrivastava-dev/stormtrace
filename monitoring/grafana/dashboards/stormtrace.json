{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "1 = database opened read-only on the last scrape. 0 = pipeline writing or database unavailable.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "text": "BUSY", "color": "orange" },
                "1": { "text": "UP", "color": "green" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_database_reachable",
          "refId": "A"
        }
      ],
      "title": "Database",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Failing (blocking) data-quality checks. Anything above zero stopped the pipeline before Gold rebuild.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_quality_failures",
          "refId": "A"
        }
      ],
      "title": "Quality Failures",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Space-weather environment factor. 1.0 = quiet, 0.9 = fast solar wind, 0.8 = sustained southward Bz. A drop here is a system-wide stress signal.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.85 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_environment_factor",
          "refId": "A"
        }
      ],
      "title": "Environment Factor",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Distinct NORAD objects ever tracked in orbital history.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_objects_tracked",
          "refId": "A"
        }
      ],
      "title": "Objects Tracked",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Measured SGP4 propagation-disagreement pairs between consecutive public element sets.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_disagreement_pairs",
          "refId": "A"
        }
      ],
      "title": "Measured Pairs",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Median total disagreement across measured pairs (km).",
      "fieldConfig": {
        "defaults": { "unit": "lengthkm", "decimals": 3 },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_disagreement_median_km",
          "refId": "A"
        }
      ],
      "title": "Median Disagreement",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Point-in-time validation: Spearman correlation between predicted ORI score and measured error (negative is correct). The metric label distinguishes all-pairs vs drag-like subsets.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": -0.5 },
              { "color": "green", "value": -0.3 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_validation_metric{metric=\"spearman_score_vs_total_km\"}",
          "legendFormat": "score vs error (all pairs)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_validation_metric{metric=\"spearman_score_vs_total_km_drag_like\"}",
          "legendFormat": "score vs error (drag-like)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_validation_metric{metric=\"spearman_age_vs_total_km\"}",
          "legendFormat": "age vs error",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_validation_metric{metric=\"spearman_score_vs_km_per_hour\"}",
          "legendFormat": "score vs rate",
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_validation_metric{metric=\"spearman_altitude_vs_total_km_drag_like\"}",
          "legendFormat": "altitude vs error (drag-like)",
          "refId": "E"
        }
      ],
      "title": "ORI Validation (Spearman)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Hours of disturbed space weather in the last 24 h.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 4 },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_spaceweather_min_bz_nt",
          "legendFormat": "min Bz (nT)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_spaceweather_southward_bz_hours",
          "legendFormat": "southward-Bz hours",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_spaceweather_fast_wind_hours",
          "legendFormat": "fast-wind hours",
          "refId": "C"
        }
      ],
      "title": "Space Weather (24 h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Maximum measured disagreement (km) — the maneuver-contaminated outliers.",
      "fieldConfig": { "defaults": { "unit": "lengthkm", "decimals": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_disagreement_max_km",
          "refId": "A"
        }
      ],
      "title": "Max Disagreement",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Objects currently in each ORI reliability class. Watch the low/reduced counts climb during a storm.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_ori_class_objects",
          "legendFormat": "{{reliability_class}}",
          "refId": "A"
        }
      ],
      "title": "Reliability Class Distribution",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Median public element age per tracked group (hours). Freshness is the ORI's second input.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "m",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_freshness_median_age_hours * 60",
          "legendFormat": "{{source_group}}",
          "refId": "A"
        }
      ],
      "title": "Median Element Age by Group",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Objects in the iridium-33 debris cohort (one collision event, ~780 km band, no maneuvers). The cleanest drag signal in the catalog.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 17 },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_debris_objects",
          "refId": "A"
        }
      ],
      "title": "Debris Cohort",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Debris objects whose public elements are older than 24 h. High values mean the drag signal is derived from stale ephemerides.",
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "max": 100, "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 17 },
      "id": 13,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_debris_stale_percent",
          "refId": "A"
        }
      ],
      "title": "Debris Stale %",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Daily Kp sums recorded over the 5-year index window. Max possible is 72. The 2024-05-11 storm reached 67.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 17 },
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_sw_max_kp_sum_5y",
          "refId": "A"
        }
      ],
      "title": "Peak Daily Kp Sum",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Newest indexed day's three-hourly Kp indices summed (provisional days may still be revised by CelesTrak).",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 17 },
      "id": 15,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_sw_latest_kp_sum",
          "refId": "A"
        }
      ],
      "title": "Latest Kp Sum",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Newest indexed day's F10.7 solar flux (sfu). A rising solar-cycle baseline makes drag events more frequent.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 17 },
      "id": 16,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_sw_latest_f10_7",
          "refId": "A"
        }
      ],
      "title": "Latest F10.7",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Distinct SatNOGS observations recorded. Independent crowd-sourced evidence that tracked populations are still being heard. Counted once per observation, not once per stored version.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 17 },
      "id": 17,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_satnogs_observations",
          "refId": "A"
        }
      ],
      "title": "SatNOGS Observations",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Passes that reached a final vetted outcome (good, bad or failed). Scheduled 'future' passes are excluded: they are coverage, not outcomes. This series is empty until the first pass completes, which is the honest signal for an unknown value.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 21 },
      "id": 18,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_satnogs_completed_observations",
          "refId": "A"
        }
      ],
      "title": "SatNOGS Completed Passes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Share of COMPLETED SatNOGS passes vetted good. The denominator excludes scheduled passes, so this is a real success rate rather than a diluted one. The API omits the metric entirely while nothing has completed: an absent series means unknown, whereas 0 would wrongly read as 'everything failed'.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "green", "value": 70 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 21 },
      "id": 19,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stormtrace_satnogs_good_percent_of_completed",
          "refId": "A"
        }
      ],
      "title": "SatNOGS Good Pass Rate",
      "type": "stat"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["stormtrace", "space", "research"],
